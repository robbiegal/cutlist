# Normalise to LF in the repo, check out native. Without this, developing on
# Windows makes every file look modified on a Linux checkout.
* text=auto eol=lf

# Golden files are compared byte-for-byte. CRLF normalisation would produce
# phantom diffs on every cross-platform checkout and break the comparison that
# guards the whole graph emitter.
tests/golden/** -text

*.png binary
*.jpg binary
*.ttf binary
*.otf binary
*.woff2 binary
*.mp4 binary
*.mov binary
*.wav binary
